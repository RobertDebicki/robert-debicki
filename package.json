{
  "name": "robert-debicki",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "sprawdz:sekrety": "tsx skrypty/skan-sekretow.ts .",
    "sprawdz:skany": "tsx skrypty/sprawdz-skany.ts .",
    "test:e2e": "playwright test",
    "test:produkcja": "playwright test -c playwright.produkcja.config.ts",
    "sprawdz:tresc": "tsx skrypty/sprawdz-tresc.ts .",
    "sprawdz:lighthouse": "node skrypty/lighthouse.mjs",
    "sprawdz:tlumaczenia": "python3 -m unittest discover -s narzedzia/tlumaczenie -p 'test_*.py' -b && python3 narzedzia/tlumaczenie/kontrola_tlumaczenia.py --katalog src/content",
    "sprawdz": "npm run sprawdz:sekrety && npm run sprawdz:tresc && npm run sprawdz:skany && npm run sprawdz:tlumaczenia && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "astro": "^7.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
