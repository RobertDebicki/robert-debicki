---
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/onest';
import '@fontsource-variable/spline-sans-mono';
import '../styles/tokeny.css';
import '../styles/baza.css';
import '../styles/sekcje.css';
import anybodyLatin from '@fontsource-variable/anybody/files/anybody-latin-wdth-normal.woff2?url';
import anybodyLatinExt from '@fontsource-variable/anybody/files/anybody-latin-ext-wdth-normal.woff2?url';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import onestLatinExt from '@fontsource-variable/onest/files/onest-latin-ext-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/spline-sans-mono/files/spline-sans-mono-latin-wght-normal.woff2?url';
import Naglowek from '../components/Naglowek.astro';
import Stopka from '../components/Stopka.astro';
import Raster from '../components/Raster.astro';

interface Props {
  jezyk: 'pl' | 'en';
  tytul: string;
  opis: string;
  /** Dokładny odpowiednik tej strony w drugim języku. Jest podstawą `hreflang` i domyślnym celem przełącznika. */
  odpowiednik?: string;
  /** Cel przełącznika języka, gdy odpowiednika nie ma, a jest lista zastępcza (bez `hreflang`). */
  przelacznik?: string;
  /** Wymusza noindex niezależnie od PUBLIC_INDEKSUJ i pomija canonical (strona 404 nie ma adresu kanonicznego). */
  noindex?: boolean;
}
// Fonty z pierwszego ekranu ładowane równolegle z HTML, a nie dopiero po odczytaniu CSS.
const fontyKrytyczne = [anybodyLatin, anybodyLatinExt, onestLatin, onestLatinExt, monoLatin];
const { jezyk, tytul, opis, odpowiednik, przelacznik = odpowiednik, noindex = false } = Astro.props;
const kanoniczny = new URL(Astro.url.pathname, Astro.site).href;
const adres = (sciezka: string) => new URL(sciezka, Astro.site).href;
const drugi = jezyk === 'pl' ? 'en' : 'pl';
const indeksuj = import.meta.env.PUBLIC_INDEKSUJ === 'true' && !noindex;
// Podgląd linku (LinkedIn, Slack, mail): public/og.png, generowany przez skrypty/obraz-og.mjs.
const obrazOg = adres('/og.png');
const lokalizacja = { pl: 'pl_PL', en: 'en_US' } as const;
---
<!doctype html>
<html lang={jezyk}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {!indeksuj && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={opis} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && <link rel="canonical" href={kanoniczny} />}
    {odpowiednik && (
      <>
        <link rel="alternate" hreflang={jezyk} href={kanoniczny} />
        <link rel="alternate" hreflang={drugi} href={adres(odpowiednik)} />
        <link rel="alternate" hreflang="x-default" href={jezyk === 'pl' ? kanoniczny : adres(odpowiednik)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Robert Dębicki" />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:locale" content={lokalizacja[jezyk]} />
    {odpowiednik && <meta property="og:locale:alternate" content={lokalizacja[drugi]} />}
    <meta property="og:image" content={obrazOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Robert Dębicki, Automation Developer / AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="glowa" />
    <meta name="generator" content={Astro.generator} />
    {fontyKrytyczne.map((f) => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
    <title>{tytul}</title>
    <noscript><style>.plates .p { display: none; } .job .fig { background-size: 2.6em 0.13em; }</style></noscript>
  </head>
  <body>
    <Raster />
    <Naglowek jezyk={jezyk} przelacznik={przelacznik} />
    <div class="sheet">
      <svg class="crop tl" viewBox="0 0 28 28" aria-hidden="true"><path d="M0 20h14M20 0v14" stroke="currentColor" stroke-width="1"/></svg>
      <svg class="crop tr" viewBox="0 0 28 28" aria-hidden="true"><path d="M0 20h14M20 0v14" stroke="currentColor" stroke-width="1"/></svg>
      <main>
        <slot />
      </main>
    </div>
    <slot name="poza-arkuszem" />
    <Stopka jezyk={jezyk} />
    <script>
      import '../scripts/plyty';
    </script>
  </body>
</html>
