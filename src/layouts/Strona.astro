---
import '@fontsource-variable/anybody/wdth.css';
import '@fontsource-variable/onest';
import '@fontsource-variable/spline-sans-mono';
import '../styles/tokeny.css';
import '../styles/baza.css';
import Naglowek from '../components/Naglowek.astro';
import Stopka from '../components/Stopka.astro';

interface Props {
  jezyk: 'pl' | 'en';
  tytul: string;
  opis: string;
  odpowiednik?: string;
}
const { jezyk, tytul, opis, odpowiednik } = Astro.props;
const indeksuj = import.meta.env.PUBLIC_INDEKSUJ === 'true';
---
<!doctype html>
<html lang={jezyk}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {!indeksuj && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={opis} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 64 56'><path d='M8 31C8 21.5 14 16.5 23 16.5H34' fill='none' stroke='%23ff5a1f' stroke-width='7'/><circle cx='34' cy='30' r='13.5' fill='none' stroke='%23ff5a1f' stroke-width='7'/><path d='M8 44.5V16.5M47.5 2.5V44.5' fill='none' stroke='%23131412' stroke-width='7'/></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{tytul}</title>
  </head>
  <body>
    <Naglowek jezyk={jezyk} odpowiednik={odpowiednik} />
    <div class="sheet">
      <svg class="crop tl" viewBox="0 0 28 28" aria-hidden="true"><path d="M0 20h14M20 0v14" stroke="currentColor" stroke-width="1"/></svg>
      <svg class="crop tr" viewBox="0 0 28 28" aria-hidden="true"><path d="M0 20h14M20 0v14" stroke="currentColor" stroke-width="1"/></svg>
      <main>
        <slot />
      </main>
    </div>
    <Stopka />
  </body>
</html>
