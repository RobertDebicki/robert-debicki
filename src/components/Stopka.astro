---
import type { Jezyk } from '../lib/jezyki';
import { etykiety } from '../lib/jezyki';

interface Props {
  jezyk: Jezyk;
}
const e = etykiety(Astro.props.jezyk);
---
<footer class="slug mono">
  <span>robert-debicki · {e.stopkaArkusz}</span>
  <span>{e.stopkaFarby}</span>
  <span>© 2026 Robert Dębicki</span>
  <span><a href={e.politykaAdres}>{e.zgodaPolitykaLink}</a> · <button type="button" class="zgoda-otworz" data-zgoda-otworz>{e.zgodaUstawienia}</button></span>
</footer>
