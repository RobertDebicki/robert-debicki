---
// Znak logo z pliku grafika (src/assets/logo/znak.svg, generowany przez skrypty/logo-z-fontu.mjs).
// Czarne części mają fill="currentColor", belka ma klasę logo-pomarancz; kolory ustawia baza.css.
import znak from '../assets/logo/znak.svg?raw';

const svg = znak.trim().replace('<svg ', '<svg class="logo" aria-hidden="true" focusable="false" ');
---
<Fragment set:html={svg} />
