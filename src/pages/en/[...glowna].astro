---
import Strona from '../../layouts/Strona.astro';
import Otwarcie from '../../components/Otwarcie.astro';
import Uslugi from '../../components/Uslugi.astro';
import Wdrozenia from '../../components/Wdrozenia.astro';
import Projekty from '../../components/Projekty.astro';
import Referencje from '../../components/Referencje.astro';
import NajnowszeWpisy from '../../components/NajnowszeWpisy.astro';
import Doswiadczenie from '../../components/Doswiadczenie.astro';
import Narzedzia from '../../components/Narzedzia.astro';
import DaneStrukturalne from '../../components/DaneStrukturalne.astro';
import Kontakt from '../../components/Kontakt.astro';
import { maStroneGlownaEn } from '../../lib/pozycje';

// Trasa z parametrem rest zamiast en/index.astro: tylko tak /en/ może nie powstać, gdy brak ustawienia/en.md
// (getStaticPaths zwraca wtedy pustą listę). Nie blokuje to wdrożenia, strona EN pojawi się z tłumaczeniem.
export async function getStaticPaths() {
  return (await maStroneGlownaEn()) ? [{ params: { glowna: undefined } }] : [];
}
---
<Strona jezyk="en" odpowiednik="/" tytul="Robert Dębicki | Automation Developer, n8n and AI systems" opis="Robert Dębicki, Automation Developer / AI. Process automation in n8n and Make.com, apps and AI deployments. Wrocław, Poland, or remote. Get in touch.">
  <Otwarcie jezyk="en" />
  <Uslugi jezyk="en" />
  <Wdrozenia jezyk="en" />
  <Projekty jezyk="en" />
  <Referencje jezyk="en" />
  <NajnowszeWpisy jezyk="en" />
  <Doswiadczenie jezyk="en" />
  <Narzedzia jezyk="en" />
  <Kontakt jezyk="en" slot="poza-arkuszem" />
  <DaneStrukturalne jezyk="en" slot="glowa" />
</Strona>
