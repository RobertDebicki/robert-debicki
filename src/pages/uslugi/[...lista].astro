---
import Strona from '../../layouts/Strona.astro';
import Uslugi from '../../components/Uslugi.astro';
import { maUslugi } from '../../lib/uslugi';
import { maStroneGlownaEn } from '../../lib/pozycje';

// Trasa rest zamiast index.astro: bez usług lista nie powstaje (getStaticPaths zwraca pustą tablicę).
export async function getStaticPaths() {
  return (await maUslugi('pl')) ? [{ params: { lista: undefined } }] : [];
}
const maEn = await maUslugi('en');
const przelacznik = maEn ? '/en/services/' : (await maStroneGlownaEn()) ? '/en/' : undefined;
---
<Strona jezyk="pl" tytul="Usługi | Robert Dębicki" opis="Usługi Roberta Dębickiego: automatyzacja procesów, wdrożenia AI i aplikacje." odpowiednik={maEn ? '/en/services/' : undefined} przelacznik={przelacznik}>
  <Uslugi jezyk="pl" lista />
</Strona>
