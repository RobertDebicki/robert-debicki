---
import Strona from '../layouts/Strona.astro';
import Otwarcie from '../components/Otwarcie.astro';
import Uslugi from '../components/Uslugi.astro';
import Wdrozenia from '../components/Wdrozenia.astro';
import Projekty from '../components/Projekty.astro';
import Referencje from '../components/Referencje.astro';
import NajnowszeWpisy from '../components/NajnowszeWpisy.astro';
import Doswiadczenie from '../components/Doswiadczenie.astro';
import Narzedzia from '../components/Narzedzia.astro';
import DaneStrukturalne from '../components/DaneStrukturalne.astro';
import Kontakt from '../components/Kontakt.astro';
import { maStroneGlownaEn } from '../lib/pozycje';

// Dopóki nie ma ustawienia/en.md, /en/ nie powstaje, więc przełącznik i hreflang się nie pojawiają.
const odpowiednik = (await maStroneGlownaEn()) ? '/en/' : undefined;
---
<Strona jezyk="pl" odpowiednik={odpowiednik} tytul="Robert Dębicki | Automation Developer, automatyzacje n8n, AI" opis="Robert Dębicki, Automation Developer / AI. Automatyzacje procesów w n8n i Make.com, aplikacje i wdrożenia AI. Wrocław albo zdalnie. Napisz do mnie.">
  <Otwarcie jezyk="pl" />
  <Uslugi jezyk="pl" />
  <Wdrozenia jezyk="pl" />
  <Projekty jezyk="pl" />
  <Referencje jezyk="pl" />
  <NajnowszeWpisy jezyk="pl" />
  <Doswiadczenie jezyk="pl" />
  <Narzedzia jezyk="pl" />
  <Kontakt jezyk="pl" slot="poza-arkuszem" />
  <DaneStrukturalne jezyk="pl" slot="glowa" />
</Strona>
