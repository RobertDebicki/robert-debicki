# Apache na home.pl. Wgrywa tylko skrypt wdroz (jako .htaccess), nie trafia do dist/ ani na Cloudflare.
# Odpowiada plikom _headers i _redirects z Cloudflare, które na tym hostingu nie działają.

# Jedna wersja adresu: https i bez www. Adresy .com i .com.pl przekierowuje panel home.pl.
# /.well-known/ zostaje bez przekierowania (odnawianie certyfikatów po HTTP).
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} !^robert-debicki\.pl$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://robert-debicki.pl%{REQUEST_URI} [R=301,L]

# Astro zapisuje mapę strony jako sitemap-index.xml; część narzędzi szuka jej pod /sitemap.xml.
# Adres bezwzględny z https: bez niego Apache zbudował przekierowanie na http://, czyli drugi skok (zmierzone 11.11).
Redirect 301 /sitemap.xml https://robert-debicki.pl/sitemap-index.xml

ErrorDocument 404 /404.html

# Pliki tekstowe (llms.txt, robots.txt) bez nagłówka charset Apache zgadywał kodowanie; polskie znaki mają być UTF-8.
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Pliki z hashem w nazwie (_astro/) nigdy się nie zmieniają, więc przeglądarka może je trzymać rok.
# Dopasowanie po rozszerzeniu zamiast zmiennej środowiskowej (ta bywa niewidoczna po wewnętrznym przekierowaniu).
<IfModule mod_headers.c>
  <FilesMatch "^[^/]+\.[A-Za-z0-9_-]{8}\.(css|js|woff2|woff|svg|png|jpg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
